{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Meu Financeiro: configurar MySQL",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/database/setup-db.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Meu Financeiro: iniciar",
      "type": "shell",
      "command": "node server.js",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
